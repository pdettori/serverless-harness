# Supervisor process management (spec §3.8)
PORT=8080
# SH_WORKERS defaults to os.cpus().length; set it to pin W across an E8 ladder.
#SH_WORKERS=4
# REQUIRED, no default: S is an OUTPUT of E8, so there is no honest value to ship (§3.8).
SH_TURNS_PER_WORKER=
SH_ROUTING_POLICY=leastInFlight
SH_WORKER_RESTART_BACKOFF_MS=250

# Sandbox discovery: on a VM there is no cluster and no kubeconfig, so records only (§2.5).
SH_SANDBOX_DISCOVERY=records
SH_REMOTE_SANDBOX=1
SH_RELAY_ADDR=127.0.0.1:9443

# Inherited unchanged from the Knative deployment.
REDIS_URL=redis://127.0.0.1:6379
KAGENTI_SANDBOX_POOL_SELECTOR=app=sandbox
# Concurrent LEASES one sandbox may hold, which is not the same quantity as concurrent execs and
# must be read against the duty cycle. A lease is held for a whole turn (run-turn.ts takes it at
# turn start and releases it in a finally), while an exec happens only on a tool call -- so leases
# scale with turn concurrency and execs with turn concurrency x duty. At duty 0.061-0.079 (spec
# §2.3's e6-ocp basis) one sandbox therefore serves ~12.6-16.5 concurrent turns, which is exactly
# the "sessions/sandbox" figure that basis quotes, and it is what duty_basis_sandbox_floor already
# assumes when it derives E8's K >= 3 precondition.
#
# So a cap of 4 is INCONSISTENT with this deployment's own floor formula, and measurably so: with
# 3 sandboxes x cap 4 = 12 leases, an E8 ladder pinned at exactly 360 successes on both c=16 and
# c=32, throughput plateaued at 10.4/s, and the run reported bound=sandbox-pool -- i.e. it measured
# the lease pool rather than the VM. Raising the cap to 13 on the same hardware took the same
# ladder to 960/960 at c=32 with p95 flat (1425ms -> 1421ms) and throughput linear to 27.3/s.
#
# 13 = the floor of the e6-ocp band. Raise it toward 16 for the e6-kind/e7 bases, whose lower duty
# implies more sessions per sandbox; lower it only if you intend to measure the pool.
KAGENTI_SANDBOX_CAP=13
